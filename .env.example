# Copy this file to .env (never commit the real .env)
# Used by the local proxy (proxy.js) as a fallback if no key is sent from the browser.

XAI_API_KEY=xai-yourkeyhere

# Optional: change default port
# PORT=3000

# --- Partner share (LO → Realtor brand plate) ---
# Public Realtor app URL used when building share links (no trailing slash)
# Local default if unset: http://localhost:3001
# Production (also auto-detected when LO is not on localhost):
REALTOR_APP_URL=https://ruoffagentsalescoach.onrender.com

# Optional: signing secret for legacy long tokens (old emails). Short share codes do not need this.
# PARTNER_CARD_SECRET=replace-with-a-long-random-string

# Optional FREE durability for short share codes across Render redeploys (Upstash Redis free tier):
# https://upstash.com → create Redis → REST URL + token
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
