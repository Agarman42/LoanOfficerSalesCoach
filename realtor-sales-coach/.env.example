# Copy this file to .env (never commit the real .env)
# Used by proxy.js as a fallback if no key is sent from the browser.
# On Render, set GROK_API_KEY / XAI_API_KEY in the dashboard.

GROK_API_KEY=xai-yourkeyhere
# XAI_API_KEY=xai-yourkeyhere

# Optional: change default port
# PORT=3000

# --- Invite-gated auth (Agent Sales Coach) ---
# Long random secret for signing session cookies (required in production)
AUTH_SESSION_SECRET=change-me-to-a-long-random-string
# First-boot admin (seeded only if no admin exists yet)
ADMIN_EMAIL=agarman42@hotmail.com
ADMIN_PASSWORD=change-me-strong-password
# ADMIN_NAME=Adam Garman
# AUTH_SESSION_DAYS=30
# AUTH_DISABLED=1   # never in production

# --- LO partner brand plate (read public LO cards) ---
# Frontend reads <meta name="lo-partner-api"> (see index.html).
# Production default in meta:
#   https://loanofficersalescoach.onrender.com
# Local browser always uses http://localhost:3000 when hostname is localhost.
